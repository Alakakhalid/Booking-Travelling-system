<style>
  .site-header { background:#f5f5f5; width:100%; }
  .nav-container { position:relative; display:flex; align-items:center; justify-content:space-between; gap:20px; padding:18px 5%; z-index:10; }
  .logo { width:52px; height:auto; }
  .nav-list { display:flex; gap:24px; list-style:none; margin:0; padding:0; }
  .nav-list a { color:#111; text-decoration:none; }
  .auth-buttons { display:flex; align-items:center; gap:12px; }
  .auth-buttons a { text-decoration:none; }
  .signup-btn,.login-btn { padding:9px 18px; border:0; border-radius:5px; background:#111; color:#fff; cursor:pointer; }
  .hambugger { display:none; cursor:pointer; flex-direction:column; gap:5px; }
  .hambugger .bar { width:25px; height:3px; background:#111; }
  @media(max-width:750px) {
    .nav-container { flex-wrap:wrap; }
    .hambugger { display:flex; }
    .nav-list,.auth-buttons { display:none; width:100%; flex-direction:column; align-items:stretch; gap:12px; }
    .nav-list.active,.auth-buttons.active { display:flex; }
    .nav-list a { display:block; padding:8px; }
  }
</style>
<header class="site-header">
  <nav class="nav-container">
    <a href="/" aria-label="Home"><img class="logo" src="/images/airflight%20logo.png" alt="AirFlight logo"></a>
    <ul class="nav-list">
      <li><a href="/">Home</a></li>
      <li><a href="/#destination">Destinations</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/destinations">Flights &amp; Hotels</a></li>
      <li><a href="/view-packages">Packages</a></li>
      <% if (user) { %><li><a href="/dashboard">Dashboard</a></li><% } %>
    </ul>
    <div class="auth-buttons">
      <% if (user) { %>
        <form action="/logout" method="POST"><button type="submit" class="login-btn">Logout</button></form>
      <% } else { %>
        <a href="/signup"><button type="button" class="signup-btn">Sign Up</button></a>
        <a href="/login"><button type="button" class="login-btn">Login</button></a>
      <% } %>
    </div>
    <button class="hambugger" type="button" aria-label="Toggle navigation" aria-expanded="false">
      <span class="bar"></span><span class="bar"></span><span class="bar"></span>
    </button>
  </nav>
</header>
